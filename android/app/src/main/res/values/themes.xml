<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="icon_bg">#0B1220</color>
    <color name="bg">#0B1220</color>

    <!-- Dark, full-bleed nav screen: no action bar, bars match the app background. -->
    <style name="Theme.OffMaps" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="colorAccent">#22D3EE</item>
    </style>
</resources>
