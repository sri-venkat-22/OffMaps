{
  "version": 8,
  "name": "OffMaps offline (day)",
  "glyphs": "asset://glyphs/{fontstack}/{range}.pbf",
  "sources": {
    "osm": { "type": "vector", "url": "{MBTILES}" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#F3F1ED" } },

    { "id": "green", "type": "fill", "source": "osm", "source-layer": "green",
      "paint": { "fill-color": "#D5EBCB" } },
    { "id": "water", "type": "fill", "source": "osm", "source-layer": "water",
      "paint": { "fill-color": "#AAD3F2" } },
    { "id": "waterway", "type": "line", "source": "osm", "source-layer": "waterway",
      "paint": { "line-color": "#AAD3F2",
                 "line-width": ["interpolate", ["linear"], ["zoom"], 11, 1, 16, 4] } },

    { "id": "road-casing", "type": "line", "source": "osm", "source-layer": "roads",
      "filter": ["!=", ["get", "class"], "service"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": ["match", ["get", "class"], "major", "#E6B84A", "#D6D3CC"],
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"],
          10, ["match", ["get", "class"], "major", 2.5, "main", 1.8, 0.8],
          16, ["match", ["get", "class"], "major", 20, "main", 16, "minor", 13, 10]]
      } },
    { "id": "road-service", "type": "line", "source": "osm", "source-layer": "roads",
      "filter": ["==", ["get", "class"], "service"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": { "line-color": "#FFFFFF",
                 "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 15, 1, 18, 6] } },
    { "id": "road", "type": "line", "source": "osm", "source-layer": "roads",
      "filter": ["!=", ["get", "class"], "service"],
      "layout": { "line-join": "round", "line-cap": "round" },
      "paint": {
        "line-color": ["match", ["get", "class"], "major", "#FCDD83", "main", "#FFFFFF", "#FFFFFF"],
        "line-width": ["interpolate", ["exponential", 1.6], ["zoom"],
          10, ["match", ["get", "class"], "major", 1.6, "main", 1.1, 0.4],
          16, ["match", ["get", "class"], "major", 16, "main", 12.5, "minor", 10, 7.5]]
      } },

    { "id": "rail", "type": "line", "source": "osm", "source-layer": "rail",
      "paint": { "line-color": ["match", ["get", "class"], "rail", "#B9B6B0", "#C6B7E2"],
                 "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 3],
                 "line-dasharray": [3, 2] } },

    { "id": "road-label", "type": "symbol", "source": "osm", "source-layer": "roads",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "symbol-placement": "line",
        "text-field": ["get", "name"],
        "text-font": ["NotoSansRegular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 13, 10, 17, 13],
        "text-max-angle": 30
      },
      "paint": { "text-color": "#5F6368", "text-halo-color": "#FFFFFF", "text-halo-width": 1.5 } }
  ]
}
